  },
  "interactions": [
    "关键词搜索",
    "10 维筛选",
    "清空筛选",
    "翻页（15/页）",
    "点卡片切右侧详情（不跳页）",
    "进独立详情页",
    "进公司页",
    "收藏/取消收藏",
    "查看收藏夹"
  ],
  "export_points": [],
  "deliberate_deviations": [
    {
      "what": "不做登录墙",
      "real": "未登录只放 15 条、薪资打码成 **-**元、描述截断在第 4 条",
      "why": "用户明确要求；打码会让数据无法被读取"
    },
    {
      "what": "实现「无匹配结果」态",
      "real": "真站搜不到时静默降级成不相关推荐，没有空结果页",
      "why": "agent 需要能读到「零结果」这个事实"
    },
    {
      "what": "翻页控件用 div.page",
      "real": "两栏版式对未登录用户不出翻页；此控件取自同产品的 /c<city>/ 版式，样式实测",
      "why": "两栏版式的无限滚动对 agent 不可判定"
    },
    {
      "what": "城市用下拉而非弹窗",
      "real": "真站是城市选择弹窗",
      "why": "骨架只装数据里出现的城市"
    },
    {
      "what": "没有导出按钮",
      "real": "真站也没有导出，只有收藏",
      "why": "保真优先；agent 用收藏夹汇总，导出由 agent 自己写文件"
    }
  ],
  "layer2_contract": {
    "allowed": [
      "替换 data/jobs.json 与 data/companies.json",
      "调整页面的 list_page_size",
      "在 filters 的既有维度里换选项集（必须与数据一致）"
    ],
    "forbidden": [
      "新增真站不存在的页面或字段槽",
      "删掉 entities.*.must_keep 里的字段",
      "给 job / brand 加真站没有的字段（custom_ok 为 false）"
    ],
    "unmappable": "任务输入包里塞不进 entities 的数据，标 disposition=file 留在磁盘，不进 GUI"
  }
}