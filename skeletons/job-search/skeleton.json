{
  "bucket": "job-search",
  "name": "招聘 / 职位搜索站",
  "reference": {
    "product": "BOSS直聘",
    "url": "https://www.zhipin.com",
    "captured": "2026-08-25",
    "access": "匿名，无需登录",
    "capture_notes": "reference/capture.md",
    "field_names_source": "GET /wapi/zpgeek/search/joblist.json 的真实响应键名"
  },
  "serves_slugs": [
    "job-search-sites",
    "job-board"
  ],
  "identity_fields": [
    "brandName",
    "bossName",
    "公司名称",
    "法定代表人"
  ],
  "runtime": {
    "type": "static",
    "backend": "none",
    "serve": "任意静态服务器，见 README.md"
  },
  "entities": {
    "job": {
      "_desc": "一条岗位。列表卡与详情面板都渲染它",
      "key": "encryptJobId",
      "data_file": "data/jobs.json",
      "data_path": "jobList",
      "custom_ok": false,
      "must_keep": [
        "encryptJobId",
        "jobName",
        "cityName",
        "areaDistrict",
        "brandName",
        "encryptBrandId"
      ],
      "fields": {
        "encryptJobId": {
          "caption": "岗位ID",
          "desc": "主键，进详情页的 URL 参数"
        },
        "jobName": {
          "caption": "岗位名",
          "desc": "列表卡标题 + 详情头"
        },
        "salaryDesc": {
          "caption": "薪资",
          "desc": "形如 15-25K / 20-30K·13薪；薪资筛选按此解析"
        },
        "jobLabels": {
          "caption": "卡片标签",
          "desc": "string[]，通常是 [经验, 学历]"
        },
        "jobExperience": {
          "caption": "工作经验",
          "desc": "枚举，见 filters.jobExperience"
        },
        "jobDegree": {
          "caption": "学历要求",
          "desc": "枚举，见 filters.jobDegree"
        },
        "cityName": {
          "caption": "城市",
          "desc": "强制检索维度：列表始终按城市过滤"
        },
        "areaDistrict": {
          "caption": "工作区域",
          "desc": "随城市动态生成筛选项"
        },
        "businessDistrict": {
          "caption": "商圈",
          "desc": "只显示，不筛选"
        },
        "jobType": {
          "caption": "求职类型",
          "desc": "0=全职 1=兼职"
        },
        "positionCategory": {
          "caption": "职位类型",
          "desc": "枚举，见 filters.positionCategory"
        },
        "skills": {
          "caption": "技能标签",
          "desc": "string[]，详情页顶部"
        },
        "welfareList": {
          "caption": "职位福利",
          "desc": "string[]"
        },
        "postDescription": {
          "caption": "职位描述",
          "desc": "长文本，只在详情页可见（换行保留）"
        },
        "jobAddress": {
          "caption": "工作地址",
          "desc": "详情页地址块"
        },
        "bossName": {
          "caption": "招聘者",
          "desc": "详情页招聘者卡"
        },
        "bossTitle": {
          "caption": "招聘者职位",
          "desc": ""
        },
        "bossOnline": {
          "caption": "在线",
          "desc": "bool"
        },
        "bossActiveTime": {
          "caption": "活跃状态",
          "desc": "如「今日活跃」"
        },
        "encryptBrandId": {
          "caption": "公司ID",
          "desc": "外键 → brand"
        },
        "brandName": {
          "caption": "公司名",
          "desc": ""
        },
        "brandIndustry": {
          "caption": "公司行业",
          "desc": "筛选维度"
        },
        "brandStageName": {
          "caption": "融资阶段",
          "desc": "筛选维度"
        },
        "brandScaleName": {
          "caption": "公司规模",
          "desc": "筛选维度"
        }
      }
    },
    "brand": {
      "_desc": "一家公司。公司主页与公司列表渲染它",
      "key": "encryptBrandId",
      "data_file": "data/companies.json",
      "data_path": "brandList",
      "custom_ok": false,
      "must_keep": [
        "encryptBrandId",
        "brandName"
      ],
      "fields": {
        "encryptBrandId": {
          "caption": "公司ID",
          "desc": "主键"
        },
        "brandName": {
          "caption": "公司名",
          "desc": ""
        },
        "brandIndustry": {
          "caption": "行业",
          "desc": ""
        },
        "brandStageName": {
          "caption": "融资阶段",
          "desc": ""
        },
        "brandScaleName": {
          "caption": "规模",
          "desc": ""
        },
        "introduction": {
          "caption": "公司简介",
          "desc": ""
        },
        "businessInfo": {
          "caption": "工商信息",
          "desc": "对象：公司名称/法定代表人/成立日期/企业类型/经营状态/注册资金"
        },
        "addresses": {
          "caption": "公司地址",
          "desc": "string[]"
        }
      }
    }
  },
  "pages": [
    {
      "id": "search",
      "file": "index.html",
      "shows": [
        "job"
      ],
      "title": "职位搜索（两栏：左列表 + 右详情，点卡不跳页）",
      "url_params": [
        "query",
        "city"
      ],
      "list_page_size": 15
    },
    {
      "id": "job_detail",
      "file": "job.html",
      "shows": [
        "job",
        "brand"
      ],
      "title": "独立岗位详情页",
      "url_params": [
        "jobId"
      ]
    },
    {
      "id": "company",
      "file": "company.html",
      "shows": [
        "brand",
        "job"
      ],
      "title": "公司主页",
      "url_params": [
        "brandId"
      ]
    },
    {
      "id": "company_list",
      "file": "companies.html",
      "shows": [
        "brand"
      ],
      "title": "公司列表"
    },
    {
      "id": "favorites",
      "file": "favorites.html",
      "shows": [
        "job"
      ],
      "title": "我的收藏（表格，可逐条移除）"
    }
  ],
  "filters": {
    "_note": "10 个维度，选项照真站 DOM 实取；单选；不选即「不限」",
    "cityName": "由数据里出现的城市动态生成",
    "areaDistrict": "随选中城市动态生成",
    "positionCategory": [
      "不限",
      "互联网/AI",
      "电子/电气/通信",
      "产品",
